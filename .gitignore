# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the TEMPLATES are part of the repo — they hold no secrets and a fresh
# clone needs them to know what to fill in.
!.env.example
!.env.production.example
!contracts/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated clients (regenerated by `postinstall` / `npm run db:generate`)
/src/generated

# dev custodial-wallet keystore (Phase 7) — local userId->account-index map
/.chain-keystore.json

# demo credential sheet (passwords + juror salts) — kept local only
docs/ChainWork_Demo_Accounts.docx

# dev outbox — mock SMS/email mirror used by scripts/demo-capture.mjs
/.dev-outbox.json

# generated demo walkthrough screenshots (regenerate with `npm run demo:capture`)
# docs/images/demo/  <- kept in git on purpose so the walkthrough renders on GitHub

# local docx review scratch (extracted images/xml) — not part of the project
/docx-review-temp/
