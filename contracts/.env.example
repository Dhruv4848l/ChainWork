# ChainWork contracts — Amoy testnet deploy config. Copy to .env and fill in.
# NEVER put a wallet with real funds here. Use a throwaway test wallet only.

# An Amoy JSON-RPC endpoint (the public one works; a provider key is more reliable):
AMOY_RPC_URL="https://rpc-amoy.polygon.technology"

# The throwaway test wallet's private key (0x-prefixed). Fund it from an Amoy faucet.
DEPLOYER_KEY=""
