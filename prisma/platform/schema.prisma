// ============================================================================
// ChainWork — PLATFORM DATABASE
// Everything Workers and Clients touch. This is one of TWO physically separate
// databases. The Admin/Jury DB (prisma/admin/schema.prisma) never holds a real
// foreign key into this one — it stores only ID references and reaches real data
// through the bridge service (Phase 10). See CLAUDE.md.
// ============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/platform"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  WORKER
  CLIENT
}

/// KYC verification tiers. The KYC gate (Phase 2) blocks money movement below VERIFIED.
enum KycTier {
  UNVERIFIED
  BASIC
  VERIFIED
  TRUSTED
}

enum ClientType {
  INDIVIDUAL
  BUSINESS
}

enum SkillProficiency {
  BEGINNER
  INTERMEDIATE
  SKILLED
  EXPERT
}

enum JobStatus {
  DRAFT
  PUBLISHED
  EXPIRED
  CANCELLED
  ARCHIVED
}

enum FundingMode {
  FUND_NOW // escrow funded at posting
  FUND_AT_HIRE // escrow funded when a worker is hired
}

/// Application lifecycle (Appendix A of the spec).
enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
  HIRED
}

enum HireStatus {
  ACTIVE
  NO_SHOW_FLAGGED
  COMPLETED
  CANCELLED
  ARCHIVED
}

/// Phase lifecycle — the heart of the phase-based escrow model (spec Appendix A).
enum PhaseStatus {
  PENDING_FUNDING // planned but not yet funded (sequential funding rule)
  FUNDED
  IN_PROGRESS
  DELIVERED
  VERIFICATION_WINDOW_OPEN
  RELEASED
  DISPUTED
  AUTO_CANCELLED
  RESOLVED // closed by a dispute verdict / settlement split (escrow RESOLVED on-chain)
}

enum EscrowTxType {
  FUND
  RELEASE
  REFUND
  SPLIT
  STAKE_LOCK
  STAKE_FORFEIT
  STAKE_REFUND
}

enum EscrowTxStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum StakeStatus {
  LOCKED
  FORFEITED
  REFUNDED
}

enum ReviewDirection {
  CLIENT_TO_WORKER
  WORKER_TO_CLIENT
}

enum ComplaintCategory {
  QUALITY
  NO_SHOW
  PAYMENT
  CONDUCT
  DAMAGE
  OTHER
}

/// The 4 triage lanes of ADM-06 (Super Admin complaint intake).
enum TriageLane {
  TRIVIAL // -> support agent resolves directly
  POLICY // -> super admin
  FINANCIAL // -> jury (escrow disputes)
  FRAUD // -> finance/compliance
}

enum ComplaintStatus {
  OPEN
  TRIAGED
  ESCALATED
  RESOLVED
  DISMISSED
}

enum NotificationType {
  APPLICATION
  ESCROW
  PAYMENT
  REMINDER
  DISPUTE
  JURY
  MESSAGE
  REVIEW
  SYSTEM
}

/// Purpose of a short-lived verification token (phase 2 auth).
enum VerificationPurpose {
  PHONE_OTP
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ---------------------------------------------------------------------------
// Identity & profiles
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  role         Role
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  name         String
  avatarUrl    String?
  dateOfBirth  DateTime?
  kycTier      KycTier  @default(UNVERIFIED)
  emailVerified Boolean @default(false)
  phoneVerified Boolean @default(false)
  onboarded    Boolean  @default(false)
  strikes      Int      @default(0)
  suspended    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workerProfile WorkerProfile?
  clientProfile ClientProfile?
  wallet        Wallet?
  verificationTokens VerificationToken[]

  jobsPosted      Job[]            @relation("ClientJobs")
  applications    JobApplication[] @relation("WorkerApplications")
  hiresAsWorker   Hire[]           @relation("WorkerHires")
  hiresAsClient   Hire[]           @relation("ClientHires")
  reviewsAuthored Review[]         @relation("ReviewAuthor")
  reviewsReceived Review[]         @relation("ReviewSubject")
  complaintsFiled Complaint[]      @relation("ComplaintFiler")
  messages        Message[]
  notifications   Notification[]
  paymentsMade     PaymentTransaction[] @relation("PaymentPayer")
  paymentsReceived PaymentTransaction[] @relation("PaymentPayee")
  ledgerEntries    LedgerEntry[]
}

model WorkerProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline           String?
  bio                String?
  experienceYears    Int      @default(0)
  /// Reference charges the worker publishes. Both are optional — a worker may quote
  /// only one. Shown on the profile/applicant card and pre-filled when applying;
  /// the binding number is still the per-hire agreed rate.
  rateHourly         Decimal? @db.Decimal(10, 2)
  rateWeekly         Decimal? @db.Decimal(12, 2)
  location           String?
  locationRadiusKm   Int      @default(10)
  availability       String? // e.g. "Weekdays", "Immediate"
  languages          String[] @default([])
  portfolioImages    String[] @default([])
  completedJobsCount Int      @default(0)
  ratingAvg          Float    @default(0)
  ratingPunctuality  Float    @default(0)
  ratingQuality      Float    @default(0)
  ratingCommunication Float   @default(0)
  // Jury-duty opt-in lives in the worker/client's own settings (WK-16 / CL-12).
  juryOptIn          Boolean  @default(false)

  skills WorkerSkill[]
}

model ClientProfile {
  id                     String     @id @default(cuid())
  userId                 String     @unique
  user                   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientType             ClientType @default(INDIVIDUAL)
  companyName            String?
  address                String?
  businessRegNumber      String?
  escrowReliabilityScore Float      @default(100)
  hiresCount             Int        @default(0)
}

// ---------------------------------------------------------------------------
// Taxonomy
// ---------------------------------------------------------------------------

model Category {
  id    String  @id @default(cuid())
  name  String  @unique
  slug  String  @unique
  icon  String?
  skills Skill[]
  jobs   Job[]
}

model Skill {
  id         String        @id @default(cuid())
  name       String        @unique
  categoryId String
  category   Category      @relation(fields: [categoryId], references: [id])
  workerSkills WorkerSkill[]
  roleLineItems JobRoleLineItem[]
}

model WorkerSkill {
  id              String           @id @default(cuid())
  workerProfileId String
  workerProfile   WorkerProfile    @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  skillId         String
  skill           Skill            @relation(fields: [skillId], references: [id])
  proficiency     SkillProficiency @default(SKILLED)

  @@unique([workerProfileId, skillId])
}

// ---------------------------------------------------------------------------
// Jobs & applications
// ---------------------------------------------------------------------------

model Job {
  id          String      @id @default(cuid())
  clientId    String
  client      User        @relation("ClientJobs", fields: [clientId], references: [id])
  title       String
  description String
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  status      JobStatus   @default(DRAFT)
  location    String?
  startDate   DateTime?
  endDate     DateTime?
  hoursPerDay Int?
  urgent      Boolean     @default(false)
  fundingMode FundingMode @default(FUND_AT_HIRE)
  publishedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  roleLineItems JobRoleLineItem[]
  applications  JobApplication[]
  hires         Hire[]
}

/// A single role-group within a job (a job can have several — e.g. 5 helpers,
/// 2 decorators, 3 electricians). Each has its own headcount and per-person rate.
model JobRoleLineItem {
  id            String  @id @default(cuid())
  jobId         String
  job           Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  roleName      String
  skillId       String?
  skill         Skill?  @relation(fields: [skillId], references: [id])
  headcount     Int     @default(1)
  perPersonRate Decimal @db.Decimal(12, 2)
  hiredCount    Int     @default(0)

  applications JobApplication[]
  hires        Hire[]
}

model JobApplication {
  id             String            @id @default(cuid())
  jobId          String
  job            Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  roleLineItemId String
  roleLineItem   JobRoleLineItem   @relation(fields: [roleLineItemId], references: [id], onDelete: Cascade)
  workerId       String
  worker         User              @relation("WorkerApplications", fields: [workerId], references: [id])
  status         ApplicationStatus @default(APPLIED)
  coverNote      String?
  proposedRate   Decimal?          @db.Decimal(12, 2)
  fitScore       Int? // 0-100, shown on CL-05
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([roleLineItemId, workerId])
}

// ---------------------------------------------------------------------------
// Hires, contracts, phases (the escrow spine)
// ---------------------------------------------------------------------------

/// One accepted worker on one role line-item. Owns one or more Phases.
model Hire {
  id             String          @id @default(cuid())
  jobId          String
  job            Job             @relation(fields: [jobId], references: [id])
  roleLineItemId String
  roleLineItem   JobRoleLineItem @relation(fields: [roleLineItemId], references: [id])
  clientId       String
  client         User            @relation("ClientHires", fields: [clientId], references: [id])
  workerId       String
  worker         User            @relation("WorkerHires", fields: [workerId], references: [id])
  status         HireStatus      @default(ACTIVE)
  totalValue     Decimal         @db.Decimal(12, 2)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  contract      Contract?
  phases        Phase[]
  deliveryStake DeliveryStake?
  reviews       Review[]
  messages      Message[]
  complaints    Complaint[]
}

model Contract {
  id                  String    @id @default(cuid())
  hireId              String    @unique
  hire                Hire      @relation(fields: [hireId], references: [id], onDelete: Cascade)
  totalValue          Decimal   @db.Decimal(12, 2)
  startDate           DateTime?
  endDate             DateTime?
  scope               String
  cancellationTerms   String?
  onChainEscrowAddress String?
  acceptedByClient    Boolean   @default(false)
  acceptedByWorker    Boolean   @default(false)
  acceptedAt          DateTime?
  createdAt           DateTime  @default(now())

  // --- Digital signature block -------------------------------------------------
  // A signature is the party typing their full legal name, bound to a SHA-256 hash
  // of the canonical contract text (parties + value + scope + the milestone
  // schedule). The hash is computed at first signature and frozen: if any term
  // changed afterwards the stored hash would no longer match a recomputation, so
  // tampering is detectable. Escrow funding is blocked until BOTH have signed.
  documentHash        String?
  clientSignature     String?
  clientSignedAt      DateTime?
  clientSignedIp      String?
  workerSignature     String?
  workerSignedAt      DateTime?
  workerSignedIp      String?
}

/// A funded, delivered, verified unit of work within a Hire. A single-session gig
/// is one Phase; a multi-stage project has several, each with its own amount and
/// delivery date, funded sequentially.
model Phase {
  id                   String      @id @default(cuid())
  hireId               String
  hire                 Hire        @relation(fields: [hireId], references: [id], onDelete: Cascade)
  index                Int // order within the hire (1-based)
  name                 String
  amount               Decimal     @db.Decimal(12, 2)
  dueDate              DateTime?
  status               PhaseStatus @default(PENDING_FUNDING)
  deliveredAt          DateTime?
  // When the worker marks delivered, the verification window opens; the contract
  // enforces on-chain that auto-release cannot happen before this deadline.
  verificationDeadline DateTime?
  releasedAt           DateTime?
  reminderCount        Int         @default(0)
  revisionCount        Int         @default(0)
  onChainEscrowAddress String?
  /// When the reconciler last compared this phase with the chain (payment plan P1.6).
  lastReconciledAt     DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  escrowTransactions EscrowTransaction[]
  payments           PaymentTransaction[]

  @@unique([hireId, index])
}

/// On-chain escrow events (fund / release / refund / split / stake ops). Also the
/// ledger the earnings & payments screens read. One Phase can have several.
model EscrowTransaction {
  id           String         @id @default(cuid())
  phaseId      String?
  phase        Phase?         @relation(fields: [phaseId], references: [id])
  type         EscrowTxType
  status       EscrowTxStatus @default(PENDING)
  amount       Decimal        @db.Decimal(12, 2)
  fromAddress  String?
  toAddress    String?
  onChainTxHash String?
  /// The PaymentTransaction that produced this row (payment plan P1). Null for rows
  /// written before the payment ledger existed.
  paymentId    String?
  createdAt    DateTime       @default(now())
}

/// A worker's refundable deposit, locked for hires above the delivery-stake
/// threshold (₹10,000 in PlatformConfig). Forfeited to the client on non-delivery.
model DeliveryStake {
  id            String      @id @default(cuid())
  hireId        String      @unique
  hire          Hire        @relation(fields: [hireId], references: [id], onDelete: Cascade)
  amount        Decimal     @db.Decimal(12, 2)
  status        StakeStatus @default(LOCKED)
  lockedAt      DateTime    @default(now())
  resolvedAt    DateTime?
  onChainTxHash String?
}

// ---------------------------------------------------------------------------
// Wallets
// ---------------------------------------------------------------------------

model Wallet {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  custodialAddress String   @unique
  // HD-account index of the custodial wallet derived from CHAIN_MNEMONIC.
  // Lives in the DB (not a local file) so it survives on serverless hosts where
  // the filesystem is read-only and ephemeral; @unique makes double-allocation
  // of the same index to two users impossible at the database level.
  custodialIndex   Int?     @unique
  externalAddress  String?  @unique
  // Cached balance for display; source of truth is on-chain (Phase 9).
  balanceCache     Decimal  @default(0) @db.Decimal(14, 2)
  // Showcase-only demo credit (testing): counts toward the displayed balance,
  // follows the same escrow rules in demos, but can NEVER be withdrawn — the
  // withdraw path only ever moves the real on-chain balance.
  demoCredit       Decimal  @default(0) @db.Decimal(14, 2)
  currency         String   @default("INR")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// DEMO payment mode (PAYMENT_MODE=demo) — a DB-backed stand-in for the chain.
// Mirrors the MockStablecoin balances and the PhaseEscrow escrows/stakes, enforcing
// the SAME rules (src/lib/chain/escrowRules.ts), so demo money behaves exactly like
// testnet money. Only src/lib/chain/demoAdapter.ts reads or writes these tables, and
// never in testnet/mainnet mode. Amounts are rupees (1 cwINR == ₹1).
// ---------------------------------------------------------------------------

model DemoAccount {
  /// Lower-case 0x address (custodial or external).
  address      String   @id
  /// Total demo balance, INCLUDING lockedCredit.
  balance      Decimal  @default(0) @db.Decimal(14, 2)
  /// The part of `balance` that came from the Wallet.demoCredit grant: spendable
  /// (spent first) but never withdrawable. Earnings received are withdrawable.
  lockedCredit Decimal  @default(0) @db.Decimal(14, 2)
  createdAt    DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DemoEscrow {
  /// keccak256 key of the Phase id (PHASE) or Hire id (STAKE) — same key as on-chain.
  key                  String   @id
  /// PHASE | STAKE
  kind                 String
  /// The Phase.id or Hire.id this entry mirrors (plain reference).
  refId                String
  client               String
  worker               String
  amount               Decimal  @db.Decimal(14, 2)
  /// PHASE: NONE..REFUNDED (escrowRules.EscrowStatus) · STAKE: LOCKED/REFUNDED/FORFEITED
  status               String
  releaseEligibleAfter Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([refId])
}

// ---------------------------------------------------------------------------
// Reviews, complaints, messaging, notifications
// ---------------------------------------------------------------------------

model Review {
  id                  String          @id @default(cuid())
  hireId              String
  hire                Hire            @relation(fields: [hireId], references: [id], onDelete: Cascade)
  direction           ReviewDirection
  authorId            String
  author              User            @relation("ReviewAuthor", fields: [authorId], references: [id])
  subjectId           String
  subject             User            @relation("ReviewSubject", fields: [subjectId], references: [id])
  ratingOverall       Int
  ratingPunctuality   Int?
  ratingQuality       Int?
  ratingCommunication Int?
  text                String?
  createdAt           DateTime        @default(now())

  @@unique([hireId, direction])
}

/// Initial issue record (WK-17 / CL-13). If triaged to the FINANCIAL lane it is
/// escalated to a DisputeCase in the ADMIN DB (referenced there by this id only).
model Complaint {
  id           String          @id @default(cuid())
  hireId       String
  hire         Hire            @relation(fields: [hireId], references: [id])
  phaseId      String?
  filedById    String
  filedBy      User            @relation("ComplaintFiler", fields: [filedById], references: [id])
  category     ComplaintCategory
  triageLane   TriageLane?
  description  String
  evidenceRefs String[]        @default([])
  status       ComplaintStatus @default(OPEN)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

/// Hire-scoped chat (no open DMs). Retained as potential dispute evidence.
model Message {
  id       String    @id @default(cuid())
  hireId   String
  hire     Hire      @relation(fields: [hireId], references: [id], onDelete: Cascade)
  senderId String
  sender   User      @relation(fields: [senderId], references: [id])
  body     String
  sentAt   DateTime  @default(now())
  readAt   DateTime?
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  linkUrl   String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
}

/// Marketing blog posts (PUB-05/06). Managed by admins (ADM-15) in Phase 10.
model BlogPost {
  id           String     @id @default(cuid())
  slug         String     @unique
  title        String
  tag          String
  excerpt      String
  body         String
  coverImage   String?
  authorName   String
  readMinutes  Int        @default(4)
  status       BlogStatus @default(PUBLISHED)
  publishedAt  DateTime   @default(now())
  createdAt    DateTime   @default(now())
}

/// Short-lived token for phone OTP, email verification, and password reset.
/// We store only a hash of the code/token, never the plaintext.
model VerificationToken {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   VerificationPurpose
  tokenHash String
  expiresAt DateTime
  attempts  Int                 @default(0)
  consumedAt DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, purpose])
}

// ---------------------------------------------------------------------------
// Payment ledger (payment plan P1). EVERY money movement — fund, release, refund,
// split, withdraw, top-up, stake — is one PaymentTransaction, created BEFORE any
// chain call so that failed and cancelled attempts are recorded too. Only
// src/lib/payments/service.ts writes these.
// ---------------------------------------------------------------------------

enum PaymentMode {
  DEMO
  TESTNET
  MAINNET
}

enum PaymentKind {
  FUND
  RELEASE
  REFUND
  SPLIT
  WITHDRAW
  TOPUP
  MOVE_TO_EXTERNAL
  STAKE_LOCK
  STAKE_REFUND
  STAKE_FORFEIT
}

/// INITIATED -> SUBMITTED -> CONFIRMED, or FAILED / CANCELLED / EXPIRED.
/// (src/lib/payments/states.ts holds the allowed transitions.)
enum PaymentStatus {
  INITIATED
  SUBMITTED
  CONFIRMED
  FAILED
  CANCELLED
  EXPIRED
}

enum SignerKind {
  CUSTODIAL
  EXTERNAL_WALLET
  DEMO_SIGNATURE
  RELAYER
}

model PaymentTransaction {
  id            String        @id @default(cuid())
  kind          PaymentKind
  mode          PaymentMode
  status        PaymentStatus @default(INITIATED)
  payerUserId   String?
  payer         User?         @relation("PaymentPayer", fields: [payerUserId], references: [id])
  payeeUserId   String?
  payee         User?         @relation("PaymentPayee", fields: [payeeUserId], references: [id])
  fromAddress   String?
  toAddress     String?
  /// Rupee value of the movement (for SPLIT: the whole escrow being split).
  amountInr     Decimal       @db.Decimal(14, 2)
  /// SPLIT only: the worker's share in basis points (0..10000).
  splitWorkerBps Int?
  assetSymbol   String        @default("cwINR")
  assetChainId  Int?
  /// null = the configured stablecoin (or a native coin in PhaseEscrow v2).
  assetAddress  String?
  /// Exact base units as a string (wei for 18-decimal tokens).
  assetAmount   String?
  quoteId       String?
  quoteRate     Decimal?      @db.Decimal(24, 8)
  signer        SignerKind
  /// The chain operation performed (fundPhase, approveRelease, autoRelease, …).
  operation     String
  txHash        String?       @unique
  blockNumber   BigInt?
  gasUsed       String?
  gasFeeWei     String?
  failureCode   String?
  failureReason String?
  /// true when the reconciler (not the original request) finalised this payment.
  reconciled    Boolean       @default(false)
  phaseId       String?
  phase         Phase?        @relation(fields: [phaseId], references: [id])
  hireId        String?
  initiatedAt   DateTime      @default(now())
  submittedAt   DateTime?
  finalizedAt   DateTime?
  updatedAt     DateTime      @updatedAt

  ledger LedgerEntry[]

  @@index([payerUserId, initiatedAt])
  @@index([payeeUserId, initiatedAt])
  @@index([status, initiatedAt])
  @@index([phaseId])
}

enum LedgerBucket {
  WALLET // the user's spendable wallet balance
  ESCROW // money the user has locked in escrow
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

/// Double-entry-style movement rows, written in the same DB transaction that marks a
/// payment CONFIRMED. Running balances are computed on read (statements, P2).
model LedgerEntry {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id])
  paymentId String
  payment   PaymentTransaction @relation(fields: [paymentId], references: [id])
  bucket    LedgerBucket
  direction LedgerDirection
  amountInr Decimal            @db.Decimal(14, 2)
  memo      String
  createdAt DateTime           @default(now())

  @@index([userId, createdAt])
  @@index([paymentId])
}

