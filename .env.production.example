# =============================================================================
# ChainWork — PRODUCTION (testnet) environment
# =============================================================================
# This is the exact set of variables the deployed app needs. Do NOT commit a
# filled-in copy — paste the values into your host's environment settings
# (Vercel: Project -> Settings -> Environment Variables, scope "Production").
#
# MONEY RULE: this stack stays on the Polygon Amoy TESTNET with a mock stablecoin
# until a professional smart-contract audit. Never point CHAIN_* at mainnet.
# =============================================================================

# ---- Databases (two SEPARATE Postgres instances — the two-DB rule) ----
# Use the POOLED connection string from Neon (host contains "-pooler") for the
# running app: serverless functions open a connection per instance and exhaust a
# direct Postgres endpoint fast. Keep the DIRECT (non-pooler) string for running
# migrations from your machine.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/chainwork_platform?sslmode=require&pgbouncer=true&connection_limit=1
ADMIN_DATABASE_URL=postgresql://USER:PASSWORD@ep-yyy-pooler.REGION.aws.neon.tech/chainwork_admin?sslmode=require&pgbouncer=true&connection_limit=1

# ---- Auth ----
# Fresh random value — NOT the dev one. Rotating it logs everyone out.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# ---- Blockchain (Polygon Amoy testnet) ----
CHAIN_RPC_URL=https://rpc-amoy.polygon.technology
CHAIN_ID=80002
# Testnet mnemonic. Index 0 = platform relayer/attestor (must hold Amoy POL for
# gas); indexes 1.. are handed out as user custodial wallets. TESTNET ONLY — this
# single mnemonic controls every custodial wallet, which is exactly why real money
# never touches it (see docs/PRE_MAINNET_CHECKLIST.md).
CHAIN_MNEMONIC=
CHAIN_RELAYER_INDEX=0
# From contracts/deployments/amoy.json after `npm run deploy:amoy`.
CHAIN_ESCROW_ADDRESS=
CHAIN_TOKEN_ADDRESS=
# Gas sponsorship for custodial wallets (src/lib/chain/gas.ts). The relayer tops a
# user's wallet up to CHAIN_GAS_TOPUP_AMT whenever it falls below _MIN, so users
# never hold gas. Defaults shown; raise them if Amoy transactions start failing.
CHAIN_GAS_TOPUP_MIN=0.02
CHAIN_GAS_TOPUP_AMT=0.05

# ---- Escrow cron ----
# Required in production: /api/cron/escrow returns 401 without it.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# ---- App URL ----
# Your real domain, no trailing slash. Emailed verification/reset links are built
# from this — leave it as localhost and every link in production is broken.
APP_BASE_URL=https://your-domain

# ---- Email ----
# mock | resend | brevo.  "mock" logs to the server console instead of sending.
EMAIL_PROVIDER=resend
EMAIL_FROM=ChainWork <no-reply@your-domain>
RESEND_API_KEY=
# BREVO_API_KEY=

# ---- SMS ----
# mock | twilio | fast2sms.  A Twilio TRIAL account can only text numbers verified
# in the Twilio console — real signups from other numbers will fall back to the
# console log and the user will never receive an OTP.
SMS_PROVIDER=twilio
SMS_DEFAULT_COUNTRY_CODE=+91
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# FAST2SMS_API_KEY=

# NOTE: NODE_ENV is set to "production" by the host automatically. Do not set it
# yourself. It is what disables the dev quick-login panel, stops the admin TOTP
# code being logged, marks session cookies Secure, and switches the dev outbox off.
